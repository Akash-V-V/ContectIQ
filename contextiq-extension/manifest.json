{
  "manifest_version": 3,
  "name": "ContextIQ",
  "version": "1.0.0",
  "description": "AI-powered writing assistant for the web",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:3001/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ContextIQ"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}